# Copy to frontend/.env.local
NEXTAUTH_URL=http://localhost:3001
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Must be identical to BACKEND_JWT_SECRET in backend/.env
BACKEND_JWT_SECRET=

# Backend URL used by the browser
NEXT_PUBLIC_API_URL=http://localhost:3000
# Backend URL used by the Next.js server to check passwords (defaults to NEXT_PUBLIC_API_URL)
# BACKEND_URL=http://localhost:3000
