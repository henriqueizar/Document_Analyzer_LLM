// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  name         String?
  /// scrypt hash (never the password itself). Null for accounts created
  /// before local login: the admin sets a password to activate them.
  passwordHash String?
  role         Role       @default(USER)
  /// When the user read and accepted the privacy notice (shown after the first login).
  privacyAcceptedAt DateTime?
  /// Language of the interface and of the LLM's explanations and answers
  /// for this user: "pt" or "en". Defaults to the installation's language.
  language     String     @default("pt")
  documents    Document[]
  teams        TeamMember[]
  questions    LlmInteraction[]
  createdAt    DateTime   @default(now())
}

/// A group of people (usually a department) that documents can be shared with.
/// Created and managed by administrators; unused installations have none.
model Team {
  id        String          @id @default(uuid())
  name      String          @unique
  members   TeamMember[]
  shares    DocumentShare[]
  createdAt DateTime        @default(now())
}

model TeamMember {
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([teamId, userId])
  @@index([userId])
}

/// A document made visible to the members of a team by its owner. Members see
/// the file and the explanation and ask in their own chat; only the owner can
/// reprocess, delete or change the sharing.
model DocumentShare {
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([documentId, teamId])
  @@index([teamId])
}

enum DocumentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Document {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  originalName  String
  filename      String
  filePath      String
  extractedText String?
  /// Reading the document (OCR / text layer): PENDING = queued,
  /// PROCESSING = reading, COMPLETED = text ready (questions allowed), FAILED.
  status        DocumentStatus   @default(PENDING)
  /// Why reading failed, shown to the user.
  failureReason String?
  /// The automatic explanation, tracked apart from reading: an LLM outage
  /// does not make a document that was read successfully unusable.
  explanationStatus DocumentStatus?
  explanationError  String?
  interactions  LlmInteraction[]
  shares        DocumentShare[]
  createdAt     DateTime         @default(now())
}

model LlmInteraction {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  /// Who asked (QUESTION). Each person sees only their own questions, also on
  /// shared documents. Null for the explanation, which is shared.
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  question   String
  answer     String
  role       String
  /// Document passages sent to the model for this answer: [{ page, text }].
  /// Lets users check exactly what each [p. N] citation refers to.
  sources    Json?
  /// STRICT: only what the document states. INTERPRETATION: the model's
  /// analysis, requested explicitly by the user and always labelled as such.
  mode       String   @default("STRICT")
  /// Language the answer was generated in ("pt" / "en").
  language   String?
  /// On-demand translations: { "<lang>": { text, verified } }. The original
  /// answer is never replaced.
  translations Json?
  createdAt  DateTime @default(now())

  @@index([documentId, userId])
}