# Copy to backend/.env
DATABASE_URL="postgresql://paggo:paggo@localhost:5432/paggo_db"

# Shared with the frontend; must be identical in frontend/.env.local.
# Generate with: openssl rand -base64 32
BACKEND_JWT_SECRET=

# Browser origin(s) allowed by CORS (comma-separated)
FRONTEND_ORIGIN=http://localhost:3001

# OpenAI-compatible LLM endpoint. Default: Ollama running natively on this machine.
# If Ollama runs in Docker (profile "ollama"), the default URL also works.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=gemma:2b

# Maximum PDF pages processed per document
MAX_PDF_PAGES=50
