# Copy to backend/.env
DATABASE_URL="postgresql://paggo:paggo@localhost:5432/paggo_db"

# Shared with the frontend; must be identical in frontend/.env.local.
# Generate with: openssl rand -base64 32
BACKEND_JWT_SECRET=

# Browser origin(s) allowed by CORS (comma-separated)
FRONTEND_ORIGIN=http://localhost:3001

# Local LLM (Ollama native API). On macOS run Ollama natively (it uses the GPU).
OLLAMA_URL=http://localhost:11434
# Recommended for 16 GB of RAM: qwen3:8b (ollama pull qwen3:8b).
# With 8 GB of RAM use a smaller model, e.g. qwen3:4b or gemma3:4b.
LLM_MODEL=qwen3:8b
# Context window in tokens (document excerpts + question + answer).
# Larger = more of the document per question, but more memory and slower.
LLM_NUM_CTX=8192
# How long to wait for one LLM answer (ms)
LLM_TIMEOUT_MS=300000

# Maximum PDF pages processed per document
MAX_PDF_PAGES=50
